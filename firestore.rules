rules_version = '2';

// Règles de sécurité P-Flow.
// - Tout le monde peut créer un compte et utiliser l'appli (accès ouvert).
// - Condition : une adresse email vérifiée (automatique avec Google, par lien pour un compte email).
// - Chaque personne ne voit et ne modifie que ses propres données (users/{son uid}).
// - Tout le reste est refusé.
service cloud.firestore {
  match /databases/{database}/documents {

    function verified() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }

    // Compatibilité avec les anciennes versions de l'appli (avant 0.1.1), qui vérifiaient
    // encore la liste d'emails : chacun peut seulement lire sa propre entrée.
    match /allowlist/{mail} {
      allow get: if verified() && mail == request.auth.token.email.lower();
    }

    match /users/{uid}/{document=**} {
      allow read, write: if verified() && request.auth.uid == uid;
    }
  }
}
